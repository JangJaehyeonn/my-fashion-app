# backend/.env.example — 복사해서 backend/.env 로 만들고 값을 채운다 (backend/.env는 git 추적 안 함). 실제 키를 여기에 쓰지 말 것.

# ── 필수 (없으면 기동 실패) ───────────────────────────────
# Base64 인코딩된 32바이트 이상 키. 생성: openssl rand -base64 48
JWT_SECRET=
# 소셜 로그인. 아이디·비밀번호 로그인만 쓸 거면 임의 문자열이어도 기동은 된다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── DB / Redis (기본값: 로컬 docker compose) ──────────────
# DB_URL=jdbc:postgresql://localhost:5432/fashionapp
# DB_USERNAME=fashionapp
# DB_PASSWORD=fashionapp
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── 이미지 저장소 ─────────────────────────────────────────
# local(기본) | s3 (AWS S3, Tencent COS 등 S3 호환)
# STORAGE_TYPE=local
# local 저장 경로. 기본: ~/fashionapp-storage (프로젝트 밖). 레포 안 경로를 쓰면 .gitignore 처리가 필요하다
# STORAGE_LOCAL_ROOT=
# STORAGE_TYPE=s3 일 때만 (Tencent COS 예: endpoint=https://cos.<region>.myqcloud.com, path-style=false)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=false

# ── 서버 주소 (로컬 기본값이 있고, 운영 프로필(prod)에서는 전부 필수) ──
# 클라이언트가 이 서버에 접근하는 공개 주소. local 저장소의 이미지 URL에 쓰인다
# PUBLIC_BASE_URL=http://localhost:8080
# 웹 프론트엔드 주소 / 브라우저 CORS 허용 출처(쉼표 구분, * 금지)
# FRONTEND_URL=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 앱 딥링크 (OAuth 성공/실패 후 앱으로 돌아오는 주소)
# OAUTH2_REDIRECT_BASE=fashionapp://app

# ── 날씨 (OpenWeatherMap, 백엔드가 직접 호출) ─────────────
# https://openweathermap.org/api 에서 발급 (Current Weather). 발급 직후엔 키가 활성화될 때까지 401이 날 수 있다
WEATHER_API_KEY=

# ── AI 서버 ───────────────────────────────────────────────
# AI_SERVER_URL=http://localhost:8000
# AI_SERVER_CONNECT_TIMEOUT=3s
# AI_SERVER_READ_TIMEOUT=30s
# AI_SERVER_VTON_READ_TIMEOUT=170s

# ── 운영 배포 시 ──────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod   # 위 서버 주소 값이 비어 있거나 localhost/http면 기동을 중단한다
